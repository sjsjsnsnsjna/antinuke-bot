# Discord Bot Token (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Bot Application ID (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# Sunucu ID (Geliştirici Modu açıkken sunucu adına sağ tıklayın > ID Kopyala)
GUILD_ID=

# Log kanalının ID'si (opsiyonel, /log-kanal-ayarla komutuyla da ayarlanabilir)
LOG_CHANNEL_ID=

# Sistem sahipleri (virgülle ayrılmış user ID'leri, başlangıçta otomatik whitelist'e eklenir)
OWNER_IDS=

# Botun hep içinde durmasını istediğin ses kanalının ID'si (opsiyonel)
VOICE_CHANNEL_ID=
